{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/account": {
      "entry": ["module-federation.config.ts", "src/App.tsx"],
      "project": ["*.ts", "src/**/*.tsx"]
    },
    "apps/admin": {
      "entry": ["module-federation.config.ts", "src/App.tsx"],
      "project": ["*.ts", "src/**/*.tsx"]
    },
    "apps/cart": {
      "entry": ["module-federation.config.ts", "src/App.tsx"],
      "project": ["*.ts", "src/**/*.tsx"]
    },
    "apps/checkout": {
      "entry": ["module-federation.config.ts", "src/App.tsx"],
      "project": ["*.ts", "src/**/*.tsx"]
    },
    "apps/home": {
      "entry": ["module-federation.config.ts", "src/App.tsx"],
      "project": ["*.ts", "src/**/*.tsx"]
    },
    "apps/product": {
      "entry": ["module-federation.config.ts", "src/App.tsx"],
      "project": ["*.ts", "src/**/*.{ts,tsx}"]
    },
    "apps/shell": {
      "entry": ["module-federation.config.ts", "src/App.tsx"],
      "ignoreDependencies": [
        "@ecommerce-mf/api",
        "account",
        "admin",
        "cart",
        "checkout",
        "home",
        "product"
      ],
      "project": ["*.ts", "src/**/*.tsx"]
    },
    "packages/api": {
      "project": ["src/**/*.ts"]
    },
    "packages/auth-store": {
      "project": ["src/**/*.ts"]
    },
    "packages/cart-store": {
      "project": ["src/**/*.ts"]
    },
    "packages/config": {
      "project": ["src/**/*.ts"]
    },
    "packages/types": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "services/api": {}
  }
}
