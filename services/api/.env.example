NODE_ENV=development
APP_ENV=local
HOST=localhost
PORT=4000
CORS_ORIGIN=http://localhost:55010
SESSION_COOKIE_NAME=ecommerce_dev_session
SESSION_SECRET=replace-with-a-random-32-character-minimum-secret

# Local Docker Postgres. In Conductor this is injected as CONDUCTOR_PORT + 8.
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:55018/ecommerce
DIRECT_URL=postgresql://postgres:postgres@localhost:55018/ecommerce
