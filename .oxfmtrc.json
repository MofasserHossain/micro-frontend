{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "ignorePatterns": ["**/@mf-types/**", "**/dist/**", "**/node_modules/**", "apps/*/@mf-types"],
  "insertFinalNewline": true,
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all"
}
